{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "XRHeritageExperienceSpecification",
  "description": "Standardized schema for museum XR experiences generated by the XR Heritage Framework.",
  "type": "object",
  "required": ["experienceId", "metadata", "exhibitionConstraints", "chapters"],
  "properties": {
    "experienceId": {
      "type": "string",
      "description": "Unique slug for this museum experience"
    },
    "version": {
      "type": "string",
      "default": "2.0"
    },
    "metadata": {
      "type": "object",
      "required": ["title", "artistName", "medium", "museumOrCollection"],
      "properties": {
        "title": { "type": "string" },
        "artistName": { "type": "string" },
        "creationYear": { "type": "string" },
        "medium": { "type": "string" },
        "physicalDimensions": { "type": "string" },
        "museumOrCollection": { "type": "string" },
        "curatorName": { "type": "string" }
      }
    },
    "exhibitionConstraints": {
      "type": "object",
      "properties": {
        "location": { "type": "string" },
        "deviceTarget": {
          "type": "string",
          "enum": ["MobileHandheldAR", "MuseumTabletAR", "SpatialHeadsetMR", "ImmersiveVR"]
        },
        "requireHeadphones": { "type": "boolean" },
        "maxRecommendedSessionMinutes": { "type": "number", "default": 5.0 },
        "artistAutonomyBoundary": {
          "type": "string",
          "description": "Specific constraints stipulated by the artist regarding non-intrusive overlay"
        }
      }
    },
    "chapters": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["chapterId", "chapterTitle", "perspective", "narrativeText"],
        "properties": {
          "chapterId": { "type": "string" },
          "chapterTitle": { "type": "string" },
          "perspective": {
            "type": "string",
            "enum": ["PhysicalArtwork", "ArtistVoice", "CuratorialLens", "ComparativeAnalysis"]
          },
          "narrativeText": { "type": "string" },
          "mediaAssetPath": { "type": "string" },
          "audioClipPath": { "type": "string" },
          "suggestedDwellTimeSeconds": { "type": "number", "default": 20.0 },
          "hotspots": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["id", "title", "description", "perspective"],
              "properties": {
                "id": { "type": "string" },
                "title": { "type": "string" },
                "description": { "type": "string" },
                "perspective": {
                  "type": "string",
                  "enum": ["PhysicalArtwork", "ArtistVoice", "CuratorialLens", "ComparativeAnalysis"]
                },
                "contentType": {
                  "type": "string",
                  "enum": ["Image", "AudioVoiceover", "VideoNarrative", "Model3D", "InteractiveComparisonSlider"]
                },
                "normalizedCoordinates": {
                  "type": "object",
                  "properties": {
                    "x": { "type": "number", "minimum": 0, "maximum": 1 },
                    "y": { "type": "number", "minimum": 0, "maximum": 1 },
                    "z": { "type": "number", "default": 0 }
                  }
                }
              }
            }
          }
        }
      }
    },
    "tamEvaluation": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean", "default": true },
        "quickSurveyQuestions": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    }
  }
}
